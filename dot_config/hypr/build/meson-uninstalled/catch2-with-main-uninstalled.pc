prefix=/home/alext/.config/hypr/build
includedir=${prefix}/include
libdir=${prefix}/lib
srcdir=/tmp/opencode/waybar-main

Name: Catch2Main
Description: A modern, C++-native, test framework for C++14 and above (links in default main)
Version: 3.7.0
Requires: catch2 =  3.7.0
Libs: -L${prefix}/subprojects/Catch2-3.7.0/src/catch2 -lCatch2Main
Cflags: -I${prefix}/subprojects/Catch2-3.7.0/src/catch2/.. -I${srcdir}/subprojects/Catch2-3.7.0/src/catch2/.. -I${prefix}/subprojects/Catch2-3.7.0/src/catch2 -I${srcdir}/subprojects/Catch2-3.7.0/src/catch2
